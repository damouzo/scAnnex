Bootstrap: docker
From: bioconductor/bioconductor_docker:RELEASE_3_20

%labels
    Author scAnnex
    Version 1.0
    Description Pseudobulk DESeq2 analysis container: DESeq2, apeglm, optparse, jsonlite

%post
    R -e "BiocManager::install(c( \
        'DESeq2', \
        'apeglm' \
    ), ask=FALSE, update=FALSE, version=BiocManager::version())"

    R -e "install.packages(c('optparse', 'jsonlite', 'data.table', 'ggplot2'), \
        repos='https://cloud.r-project.org', quiet=TRUE)"

%test
    Rscript -e "
        suppressPackageStartupMessages({
            library(DESeq2)
            library(optparse)
            library(jsonlite)
            library(data.table)
            library(ggplot2)
        })
        cat('All pseudobulk packages loaded successfully\n')
        cat('DESeq2:', as.character(packageVersion('DESeq2')), '\n')
    "